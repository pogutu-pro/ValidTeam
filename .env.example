# ============================================
# ValidTeam - Configuration
# Copy this file: cp .env.example .env
# ============================================

# ===========================================
# APP URL (REQUIRED)
# Change this to your domain or IP
# ===========================================
APP_URL=http://localhost:3000
APP_NAME=ValidTeam

# ===========================================
# AUTH SECRET (REQUIRED)
# Generate with: openssl rand -base64 32
# ===========================================
AUTH_SECRET=
# Required unless a trusted proxy sets x-forwarded-host: Auth.js rejects hosts
# it cannot infer with UntrustedHost, which breaks /api/auth/session.
AUTH_TRUST_HOST=true

# ===========================================
# DATABASE (required; setup.sh generates a URL-safe random password)
# ===========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=validteam

# Redis password (required). Use hex output so REDIS_URL parsing is safe:
# openssl rand -hex 32
REDIS_PASSWORD=

# ===========================================
# PORTS (change if conflicts)
# ===========================================
PORT=3000
DB_PORT=5432
REDIS_PORT=6379
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_RTC_START_PORT=50000
LIVEKIT_RTC_END_PORT=50020

# ===========================================
# OAUTH (optional - for social login)
# ===========================================

# GitHub OAuth - https://github.com/settings/developers
# OPTIONAL fallback — super-admins should manage these in Admin → Integrations.
# Used both for sign-in (NextAuth) AND the workspace integration. The workspace
# integration redirects to /api/integrations/github/callback; configure
# GITHUB_INTEGRATION_REDIRECT_URI when it differs from the auto-derived value.
# Default scope when GITHUB_OAUTH_SCOPE is unset: "repo read:user".
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_INTEGRATION_REDIRECT_URI=http://localhost:3000/api/integrations/github/callback
# GITHUB_OAUTH_SCOPE=

# Google OAuth - https://console.cloud.google.com/apis/credentials
# OPTIONAL fallback — super-admins should manage these in Admin → Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# INTEGRATIONS - GitLab OAuth (OPTIONAL)
# Fallback only — prefer Admin → Integrations for runtime configuration.
# Create an application at https://gitlab.com/-/user_settings/applications
# Redirect URI must exactly match GITLAB_REDIRECT_URI.
# Scope defaults to "read_api read_repository" when GITLAB_OAUTH_SCOPE is unset.
# ===========================================
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/api/integrations/gitlab/callback
# GITLAB_OAUTH_SCOPE=

# ===========================================
# EMAIL / SMTP (optional - for notifications)
# ===========================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# EMAIL_FROM=ValidTeam <noreply@example.com>
# Where /auth/request-access notifications are delivered when signup is closed.
# ACCESS_REQUEST_ADMIN_EMAIL=admin@example.com

# ===========================================
# SELF-HOSTED CHAT / CALLS (optional)
# The Compose `voice` profile provisions LiveKit for chat voice rooms.
# LiveKit runs on the host network because the official docs recommend host networking
# in Dockerized environments for better ICE/WebRTC behavior.
# LIVEKIT_PUBLIC_HOST controls which host the browser connects to.
# Keep 127.0.0.1 for same-machine testing, or set your LAN IP when testing from another device.
# setup.sh generates both credentials; never expose known demo values.
# ===========================================
LIVEKIT_URL=
LIVEKIT_PUBLIC_HOST=127.0.0.1
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_NODE_IP=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TURN_UDP_PORT=3478

# ===========================================
# COLLABORATIVE ISSUE EDITING (optional)
# Build with docker-compose.collab.yml to enable the Hocuspocus service.
# The public WebSocket URL must be reachable by the user's browser.
#
# When the web app and Hocuspocus run on different hosts — a serverless web
# tier, or a host with no inbound ports — they must share AUTH_SECRET and
# DATABASE_URL exactly, or every socket is rejected. See
# docker-compose.serverb-collab.yml and docs/DEPLOYMENT.md.
#
# NEXT_PUBLIC_HOCUSPOCUS_URL is inlined into the client bundle at build time,
# so changing it requires a rebuild, not just a restart.
# ===========================================
NEXT_PUBLIC_COLLAB_ENABLED=false
# NEXT_PUBLIC_HOCUSPOCUS_URL=ws://127.0.0.1:1234

# Server-only health probe target for the collaboration service. Never
# exposed to the browser; /api/health uses it to report collaboration state.
# HOCUSPOCUS_INTERNAL_URL=http://hocuspocus:1234/healthz

# Optional external TURN relay, required for voice/video on restrictive
# networks. Self-hosted LiveKit cannot traverse most NATs without it.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# ===========================================
# INTEGRATIONS — Slack OAuth (OPTIONAL)
# Fallback only — prefer Admin → Integrations for runtime configuration.
# Create an app at https://api.slack.com/apps. SLACK_REDIRECT_URI must match
# the Redirect URL registered in your Slack app configuration.
# ===========================================
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# ===========================================
# INTEGRATIONS — Jira (Atlassian 3LO) OAuth (OPTIONAL)
# Fallback only — prefer Admin → Integrations. Create an app at
# https://developer.atlassian.com/console/myapps/ and register the redirect URI.
# ===========================================
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# JIRA_REDIRECT_URI=http://localhost:3000/api/integrations/jira/callback

# ===========================================
# INTEGRATIONS — Sentry OAuth (OPTIONAL)
# Fallback only — prefer Admin → Integrations. Create an OAuth app under
# Settings → Account → API → Applications on sentry.io and register the
# redirect URI. SENTRY_BASE_URL can be set when self-hosting Sentry.
# Default scope when SENTRY_OAUTH_SCOPE is unset: "org:read project:read event:read".
# ===========================================
# SENTRY_CLIENT_ID=
# SENTRY_CLIENT_SECRET=
# SENTRY_REDIRECT_URI=http://localhost:3000/api/integrations/sentry/callback
# SENTRY_OAUTH_SCOPE=
# SENTRY_BASE_URL=https://sentry.io

# ===========================================
# AI / AGENTS / BOTS
# AI is OFF by default and managed entirely from the UI (DB-backed):
#   Admin → Agent control → "Global enablement" toggle
#   Admin → Agent control → Platform provider keys (OpenAI / Anthropic)
#   Settings → AI & Agents → Per-workspace toggle + workspace keys
#
# The env vars below are OPTIONAL last-resort dev fallbacks used when
# neither the workspace nor the platform has a key configured. Prod should
# set these through the admin/workspace UI instead.
# ===========================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional comma-separated exact/wildcard host policy for remote coding-agent
# webhook endpoints, for example: agents.example.com,*.runners.example.com.
# HTTPS and public-address validation remain mandatory even when unset.
# AGENT_PROVIDER_HOST_ALLOWLIST=

# Customer-configured outbound webhooks require public HTTPS destinations by
# default. HTTP can be enabled only for an operator-controlled development
# environment; private, loopback, link-local and internal DNS destinations
# remain blocked. An optional allowlist further restricts public hosts.
# VALIDTEAM_WEBHOOK_ALLOW_INSECURE_HTTP=false
# VALIDTEAM_WEBHOOK_HOST_ALLOWLIST=

# Optional Auth.js diagnostic logging. Keep disabled outside a short-lived,
# local troubleshooting session.
# AUTH_DEBUG=false

# ===========================================
# LOCAL AGENT RUNNERS (optional beta)
# Dispatch issues directly to Claude Code or Codex CLI installed in the web
# runtime. For Docker, install the CLI in a custom image or point COMMAND to
# an executable available inside the container, then set CWD to the mounted
# repository/workspace the agent may edit.
# ===========================================
# VALIDTEAM_LOCAL_AGENT_RUNNER_ENABLED=false
# VALIDTEAM_LOCAL_AGENT_CWD=/workspace/validteam
# VALIDTEAM_REPO_ROOT=/workspace/validteam
# VALIDTEAM_LOCAL_CODEX_ENABLED=false
# VALIDTEAM_LOCAL_CODEX_COMMAND=codex
# VALIDTEAM_LOCAL_CODEX_CWD=/workspace/validteam
# VALIDTEAM_LOCAL_CODEX_MODEL=
# VALIDTEAM_LOCAL_CODEX_SANDBOX=workspace-write
# VALIDTEAM_LOCAL_CODEX_TIMEOUT_SECONDS=3600
# VALIDTEAM_LOCAL_CODEX_ARGS_JSON=
# VALIDTEAM_LOCAL_CLAUDE_ENABLED=false
# VALIDTEAM_LOCAL_CLAUDE_COMMAND=claude
# VALIDTEAM_LOCAL_CLAUDE_CWD=/workspace/validteam
# VALIDTEAM_LOCAL_CLAUDE_MODEL=
# VALIDTEAM_LOCAL_CLAUDE_PERMISSION_MODE=auto
# VALIDTEAM_LOCAL_CLAUDE_MAX_TURNS=20
# VALIDTEAM_LOCAL_CLAUDE_TIMEOUT_SECONDS=3600
# VALIDTEAM_LOCAL_CLAUDE_ARGS_JSON=

# ===========================================
# CRON / DURABLE WORK RECONCILIATION
# Required by the default approval/project-agent reconciler and all cron endpoints.
# Generate with: openssl rand -hex 32
# The approval/project-agent reconciler is part of the base Compose lifecycle. Enable the
# additional scheduled-product sidecar with:
#   CRON_SECRET=... docker compose --profile cron up -d cron
# JANITOR_SYSTEM_USER_ID is the user id used as the author for janitor
# comments and updates — when unset the janitor runs in dry-run mode
# (decisions are returned but not applied).
# ===========================================
CRON_SECRET=
# JANITOR_SYSTEM_USER_ID=

# Prometheus metrics endpoint. Generate with: openssl rand -hex 32
# GET /api/metrics requires Authorization: Bearer <this value>.
# METRICS_TOKEN=

# ===========================================
# DOCKER HUB UPDATE DETECTION (optional)
# Set this and create a Docker Hub repository webhook pointing at:
#   https://your-domain.example/api/webhooks/docker-hub?secret=<same value>
# The endpoint detects new stratnovo/validteam image tags and notifies
# super admins in-app. Generate with: openssl rand -hex 32
# ===========================================
# VALIDTEAM_DOCKER_HUB_WEBHOOK_SECRET=

# ===========================================
# SELF-UPDATE HANDOFF (optional, self-hosted)
# Disabled by default. The web container never gets Docker socket access.
# When enabled, Admin > Updates can send a signed request to an
# operator-managed updater endpoint. Keep manual Docker updates available.
#
# Generate a webhook secret with: openssl rand -hex 32
# ===========================================
# VALIDTEAM_SELF_UPDATE_ENABLED=false
# VALIDTEAM_SELF_UPDATE_WEBHOOK_URL=
# VALIDTEAM_SELF_UPDATE_WEBHOOK_SECRET=
# VALIDTEAM_SELF_UPDATE_REQUIRE_BACKUP=true
# VALIDTEAM_SELF_UPDATE_ALLOW_INSECURE_HTTP=false
# VALIDTEAM_UPDATE_BACKUP_DIR=/app/backups

# ===========================================
# FILE STORAGE (required)
# Uploads default to the local filesystem, which is fine on a VM with a
# persistent volume but NOT on serverless or ephemeral hosts, where every
# redeploy discards them. On Vercel, configure Admin -> storage_config with
# mode "s3" and these credentials, or attachments will silently vanish.
# ===========================================
UPLOAD_DIR=./.data/uploads

# S3-compatible object storage. Works with AWS S3, Cloudflare R2, MinIO and
# Backblaze B2. R2 is the cheapest option for this stack.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# MEETINGS
# Meeting emails (invitation, 30-minute reminder, no-show, summary) are sent by the
# /api/cron/meetings-tick job through the normal SMTP config. Set to false to pause.
# MEETING_NOTIFICATIONS_ENABLED=true

