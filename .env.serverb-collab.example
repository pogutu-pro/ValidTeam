# Collaboration service on a separate host (Server B shape).
#
# Copy to .env next to docker-compose.serverb-collab.yml and fill in. Never
# commit the filled-in file.
#
#   cp .env.serverb-collab.example .env
#   docker compose -f docker-compose.serverb-collab.yml --env-file .env up -d --build

# --- Web app coupling -------------------------------------------------------
# These two MUST match the values the web app runs with. If AUTH_SECRET
# differs, every socket is rejected as "Invalid collaboration token". If
# DATABASE_URL differs, the per-document authorization check cannot see the
# issue and every socket is rejected as "Not authorized for this document".

# Must be byte-identical to the web app's AUTH_SECRET.
AUTH_SECRET=

# Must point at the same Neon database the web app uses, including any
# query parameters (?sslmode=require&connection_limit=...).
DATABASE_URL=

# --- Public entry point -----------------------------------------------------
# From the Cloudflare Zero Trust dashboard: Networks > Tunnels > create a
# tunnel, then add a public hostname whose service is
# http://hocuspocus:1234. Set the resulting wss:// hostname as the web app's
# NEXT_PUBLIC_HOCUSPOCUS_URL.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional ---------------------------------------------------------------

# Leave empty for a single Hocuspocus instance. Set it only when running more
# than one node, which additionally needs pub/sub fan-out between them.
REDIS_URL=

NODE_ENV=production
