# Collaboration service on a separate host (Server B shape).
#
# Copy to .env next to docker-compose.serverb-collab.yml and fill in. Never
# commit the filled-in file.
#
#   cp .env.serverb-collab.example .env
#   docker compose -f docker-compose.serverb-collab.yml --env-file .env up -d --build

# --- Web app coupling -------------------------------------------------------
# These two MUST match the values the web app runs with. If AUTH_SECRET
# differs, every socket is rejected as "Invalid collaboration token". If
# DATABASE_URL differs, the per-document authorization check cannot see the
# issue and every socket is rejected as "Not authorized for this document".

# Must be byte-identical to the web app's AUTH_SECRET.
AUTH_SECRET=

# Must point at the same Neon database the web app uses, including any
# query parameters (?sslmode=require&connection_limit=...).
DATABASE_URL=

# --- Public entry point -----------------------------------------------------
# From the Cloudflare Zero Trust dashboard: Networks > Tunnels > create a
# tunnel, then add a public hostname whose service is
# http://hocuspocus:1234. Set the resulting wss:// hostname as the web app's
# NEXT_PUBLIC_HOCUSPOCUS_URL.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Optional ---------------------------------------------------------------

# Leave empty for a single Hocuspocus instance. Set it only when running more
# than one node, which additionally needs pub/sub fan-out between them.
REDIS_URL=

NODE_ENV=production

# --- Scheduled jobs ---------------------------------------------------------
# The `cron` service calls the Vercel-hosted web app's /api/cron/* endpoints.
# Start it with:
#   docker compose -f docker-compose.serverb-collab.yml --env-file .env \
#     --profile cron up -d cron

# Must match the web app's CRON_SECRET, otherwise every call returns 401.
CRON_SECRET=

# Public origin of the web app. No trailing slash.
CRON_WEB_BASE_URL=https://www.rumiamanage.com

# --- Voice (optional) -------------------------------------------------------
# The `voice` profile adds loopback-only Redis plus LiveKit:
#   docker compose -f docker-compose.serverb-collab.yml \
#     --env-file .env --profile voice up -d redis livekit
#
# Signalling (7880) is reached through the tunnel, but WebRTC media is UDP and
# cannot be tunnelled — see docs/DEPLOYMENT.md, "Server B host firewall" for
# the ports the provider security list must admit.

# Must match the web app's LIVEKIT_API_KEY / LIVEKIT_API_SECRET.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# This host's public IP. Advertised to browsers as the ICE candidate, so a wrong
# or private value here produces voice that only works on one machine.
LIVEKIT_NODE_IP=

LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_RTC_START_PORT=50000
LIVEKIT_RTC_END_PORT=50020
LIVEKIT_WEBHOOK_URL=https://www.rumiamanage.com/api/chat/livekit/webhook
